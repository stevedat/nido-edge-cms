{
	"name": "nido-edge-cms",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "svelte-kit sync",
		"build": "vite build --ssr && vite build",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare npm run build",
		"deploy": "DEPLOY_TARGET=cloudflare npm run build && npx wrangler pages deploy .svelte-kit/cloudflare",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"i18n:audit": "node scripts/i18n-audit.mjs",
		"i18n:check": "node scripts/i18n-audit.mjs --strict",
		"mobile:audit": "node scripts/mobile-ux-audit.mjs",
		"mobile:check": "node scripts/mobile-ux-audit.mjs --strict",
		"test:e2e": "e2e run",
		"test:e2e:ui": "e2e run --ui"
	},
	"devDependencies": {
		"@e2e-dev/web": "^0.11.2",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"ai": "^7.0.0",
		"e2e": "^0.16.0",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"playwright": "^1.63.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"zod": "^4.1.8"
	},
	"dependencies": {
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/extension-placeholder": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"gray-matter": "^4.0.3",
		"jose": "^6.2.8",
		"lucide-svelte": "^0.468.0",
		"marked": "^17.0.1",
		"tailwind-merge": "^3.7.0",
		"tiptap-markdown": "^0.9.0"
	},
	"description": "Ultra-fast, minimalist, Edge-native Multi-tenant CMS & Headless Content Engine built with SvelteKit 2, Svelte 5 Runes, and Tailwind CSS v4.",
	"author": "Steve Dat (Nido Holdings)",
	"license": "AGPL-3.0-or-later"
}

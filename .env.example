# =================================================================
# NIDO EDGE CMS · ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Site & Domain Routing
SITE_URL="https://example.com"
ROOT_DOMAIN="example.com"

# 2. Authentication & Security (REQUIRED)
# Generate a strong password for master admin login
ADMIN_PASSWORD="change-me-to-a-strong-password"
# Generate a 64-character random hex string: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"

# 3. Master API Key for Multi-Tenant Auto-Provisioning (/api/v1/tenants)
# MASTER_API_KEY="generate-a-strong-master-api-key"

# 4. Storage Adapter Configuration
# Options: 'fs' (Local/VPS/Docker default), 'cloudflare-kv' (Cloudflare Pages/Workers), 'github' (Git-backed)
# STORAGE_ADAPTER="fs"
# CONTENT_DIR="./src/content"

# Optional: GitHub Storage Adapter (For Git-backed CMS workflow)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# GITHUB_REPO="owner/repo"
# GITHUB_BRANCH="main"
# GITHUB_COMMITTER_NAME="Edge CMS Bot"
# GITHUB_COMMITTER_EMAIL="bot@example.com"

# 5. Optional AI Website Builder (Auto Mode via Gemini API)
# GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 6. Anti-Spam Proof-of-Work (PoW) Configuration
# POW_DIFFICULTY="000"
# ANTISPAM_SALT="optional-custom-salt"
